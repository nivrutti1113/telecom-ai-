# Copy to .env for local or production deployments.
# Never commit real secrets.

POSTGRES_USER=telecom
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=telecom_ai
DATABASE_URL=postgresql://telecom:change-me-postgres-password@postgres:5432/telecom_ai

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-me-minio-password

SECRET_KEY=change-me-64-character-random-jwt-secret
AUTH_CORS_ORIGINS=http://localhost:3000
PREDICTION_CORS_ORIGINS=http://localhost:3000
TWIN_CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=/api/prediction
NEXT_SERVER_API_URL=http://prediction-api:8001
NEXT_PUBLIC_TWIN_WS_URL=ws://localhost:8003/ws/network-state

GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
